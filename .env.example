# =====================================================
# Kalshi Bot - Environment Variables
# =====================================================
# Copia este archivo:
#   - Local dev: a `.env` (NUNCA commits)
#   - Coolify: pega cada variable en "Environment Variables" del servicio
# =====================================================

# Environment: "demo" o "production"
# CRITICAL: Empezar siempre en "demo". Cambiar a "production" SOLO después
# de validar el sistema 7+ días en demo sin errores.
KALSHI_ENV=demo

# Kalshi API credentials
# El Key ID lo genera Kalshi cuando subes tu public key
# La private key NO va aquí - se monta como volume secret en Coolify
KALSHI_API_KEY_ID=

# Path a la private key DENTRO del container (default: /app/secrets/kalshi_private_key.pem)
# Solo cambiar si tu setup usa otro path
KALSHI_PRIVATE_KEY_PATH=/app/secrets/kalshi_private_key.pem

# Database (path absoluto dentro del container)
DATABASE_URL=sqlite:////app/data/trades.db

# =====================================================
# Risk Management - HARDCODED defaults
# =====================================================
# NO modificar sin aprobación explícita. Estos valores son
# resultado de análisis previo, no son arbitrarios.

# Stop-loss diario: pausa 24h si pérdida acumulada del día excede esto
MAX_DAILY_LOSS_PCT=3.0

# Stop-loss semanal: pausa 7 días si pérdida acumulada de la semana excede esto
MAX_WEEKLY_LOSS_PCT=8.0

# Stop-loss mensual: kill-switch total si pérdida del mes excede esto
MAX_MONTHLY_LOSS_PCT=15.0

# Tope de exposure simultáneo (suma de todas las posiciones abiertas)
MAX_SIMULTANEOUS_EXPOSURE_PCT=25.0

# Sizing máximo por trade individual
MAX_TRADE_SIZE_PCT=5.0

# Kelly fraction: 0.25 = ¼ Kelly (conservador, recomendado retail)
KELLY_FRACTION=0.25

# Edge mínimo después de comisión para considerar un trade
MIN_EDGE_PCT=2.0

# Liquidez mínima en orderbook para ejecutar
MIN_LIQUIDITY_CONTRACTS=10

# =====================================================
# Capital
# =====================================================
# Capital actualmente desplegado en Kalshi.
# Empezar bajo, escalar después de validación.
# Fase 1 (días 1-30 demo): cualquier valor
# Fase 2 (producción inicial): $300
# Fase 3 (después validación): $800
# Fase 4 (operación): hasta $2000
ACTIVE_CAPITAL_USD=300.00

# --- Capital dinámico (lee el cash real de Kalshi) ---
# DYNAMIC_CAPITAL_ENABLED=false → ignora el cash real y usa ACTIVE_CAPITAL_USD fijo (dry-run).
DYNAMIC_CAPITAL_ENABLED=true
# Reserva: % del cash real usable (90 = 10% de colchón). NO existe CAPITAL_RESERVE_PCT aparte.
CAPITAL_SAFETY_FACTOR_PCT=90.0
# Piso (USD): debajo se pausan NUEVAS entradas; el cierre/gestión sigue. El capital efectivo
# nunca baja del piso (la matemática de riesgo no se rompe).
CAPITAL_FLOOR_USD=100.0
# Techo (USD) sobre el capital derivado del cash real (backstop adicional al hard cap de prod).
CAPITAL_CAP_USD=2000.0
# Anti-churn: cambios menores a esta fracción (0.05 = 5%) no refrescan el capital.
CAPITAL_SMOOTHING_PCT=0.05
# Intervalo de refresh del balance real (s). NO existe CAPITAL_REFRESH_SECONDS aparte.
BALANCE_REFRESH_SECONDS=300

# =====================================================
# Telegram alerts (opcional Semana 1, requerido Semana 4)
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dashboard on-demand por Telegram: /dashboard (read-only, solo el chat autorizado responde).
# Default on; no-op si Telegram no está configurado. INTERVAL_SEC>0 = además auto-envío cada N s.
TELEGRAM_DASHBOARD_ENABLED=true
TELEGRAM_DASHBOARD_INTERVAL_SEC=0

# =====================================================
# Health server
# =====================================================
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
# Nivel del log a ARCHIVO (incidente 2026-07-25: DEBUG fijo = 8.5GB/día llenó el disco).
# DEBUG solo mientras se diagnostica un incidente; el sink rota a 500MB y poda a 14 días.
LOG_FILE_LEVEL=INFO
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =====================================================
# Operational toggles
# =====================================================
# Maestro: cuando es false, el bot solo captura datos pero NO ejecuta trades.
# Activar solo cuando el sistema esté validado.
TRADING_ENABLED=false

# Por motor (granular)
MOTOR_1_ARBITRAGE_ENABLED=false
MOTOR_2_SPORTSBOOK_ENABLED=false
MOTOR_3_CLV_ENABLED=false

# Capa A por motor para las ENTRADAS (auditoría 2026-07-07): con TRADING_ENABLED solo,
# prender el trading global para que M3 venda armaba también las COMPRAS de M1/M2.
# Ahora cada motor compra/apuesta SOLO con TRADING_ENABLED + su flag de entrada.
# Shadow = MOTOR_X_ENABLED true + su EXECUTION false.
MOTOR_1_EXECUTION_ENABLED=false
# Breaker de M1 (incidente 2026-07-30: 3 rollbacks limpios de $0.21 = 12h de bot muerto).
# El abortado (huérfana) SIEMPRE cuenta; COUNT_CLEAN=false ignora los limpios. AUTO_RESUME
# despausa al vaciarse la ventana SOLO con 0 abortados y bajo el tope diario (luego, humano).
MOTOR_1_BREAKER_THRESHOLD=3
MOTOR_1_BREAKER_WINDOW_MIN=60.0
MOTOR_1_BREAKER_COUNT_CLEAN_ROLLBACKS=true
MOTOR_1_BREAKER_AUTO_RESUME=false
MOTOR_1_BREAKER_MAX_RESUMES_PER_DAY=3
# OJO: distinto de MOTOR_2_EXECUTION_ENABLED (ese gatea las VENTAS del brazo de salida).
MOTOR_2_ENTRY_EXECUTION_ENABLED=false

# Mantenimiento de DB (incidente disco-lleno 2026-07-10). orderbook_events se grababa por
# cada delta del WS (millones/día) y nadie la lee → llenó el disco. Default OFF (opt-in).
PERSIST_ORDERBOOK_EVENTS=false
# Loop de retención: poda tablas de diagnóstico por ventana + WAL checkpoint (nunca toca
# estado de trading). Default on; acota el crecimiento de la DB.
DB_MAINTENANCE_ENABLED=true
DB_MAINTENANCE_INTERVAL_HOURS=6.0

# Stop-losses a escala chica (2026-07-12): límite efectivo = max(capital × %, piso USD).
# Con capital chico los % puros daban límites de ruido ($5.40/día con $180) que apagaban
# el bot entero. Piso 0 = comportamiento histórico (solo %).
MAX_DAILY_LOSS_FLOOR_USD=20.0
MAX_WEEKLY_LOSS_FLOOR_USD=40.0
MAX_MONTHLY_LOSS_FLOOR_USD=60.0
# Breach DIARIO: true (default) = pausa solo entradas nuevas hasta el rollover UTC
# (auto-recupera, sin clear manual). Semanal/mensual SIEMPRE kill-switch persistente.
DAILY_STOP_ENTRIES_ONLY=true
# Stop-loss ROLLING (2026-07-17): ventana MÓVIL de N días — atrapa la sangría gradual que
# las ventanas de calendario dejan pasar (M2: −$430 repartidos jun→jul sin breach mensual).
# ⚠️ Activarlo con un drawdown histórico dentro de la ventana latchea el kill-switch en el
# PRIMER intento de entrada (requiere clear_kill_switch.py). Decisión explícita del operador.
ROLLING_DRAWDOWN_STOP_ENABLED=false
MAX_ROLLING_DRAWDOWN_PCT=15.0
MAX_ROLLING_DRAWDOWN_DAYS=30
MAX_ROLLING_DRAWDOWN_FLOOR_USD=60.0
# Gate SOFT de pérdida LATENTE (mark-to-market de posiciones abiertas): pausa solo entradas
# nuevas (sin kill-switch). ⚠️ Cambia la semántica realized-only — default off, decisión del
# owner. Marks: los publican M3/M2-exit (pasajero, cero I/O extra); sin mark fresco no cuenta.
UNREALIZED_STOP_ENABLED=false
MAX_UNREALIZED_LOSS_PCT=10.0
MAX_UNREALIZED_LOSS_FLOOR_USD=40.0
UNREALIZED_MARK_TTL_SEC=900.0
# DiskGuard: lazo CERRADO de presión de disco (2026-07-10: el WAL a ~8MB/s llenó el 96% sin
# que el bot lo viera). WARN → alerta + poda inmediata; CRITICAL → además descarta telemetría
# (orderbook_events/market_snapshots). El estado de trading JAMÁS se gatea.
DISK_GUARD_ENABLED=true
DISK_GUARD_INTERVAL_MINUTES=5.0
DISK_GUARD_WARN_FREE_GB=5.0
DISK_GUARD_CRITICAL_FREE_GB=2.0

# Motor 2 — cierre de posiciones (take-profit/trailing). Shadow-first: con TAKE_PROFIT_ENABLED
# true + EXECUTION_ENABLED false, detecta y loguea [MOTOR 2 TP SHADOW] con net de fees pero NO
# vende. Validar el net contra el backtest antes de poner EXECUTION_ENABLED=true.
MOTOR_2_TAKE_PROFIT_ENABLED=false
MOTOR_2_TAKE_PROFIT_CENTS=90
MOTOR_2_TRAILING_ENABLED=false
MOTOR_2_TRAILING_DROP_CENTS=5
MOTOR_2_EXECUTION_ENABLED=false

# Auditoría rentabilidad 2026-07-07 — endurecimiento de la medición del consenso:
# mínimo de casas para que exista fair (una sola casa soft ya no forma "consenso"),
# frescura máxima del last_update por casa (0 = sin filtro), y el filtro underdog
# pasó a BLOQUEAR por default (<40c sangró −$110,77 en el histórico).
MOTOR_2_MIN_BOOKS=3
MOTOR_2_MAX_BOOK_AGE_MIN=15
MOTOR_2_UNDERDOG_FILTER_ENABLED=true

# Motor 1 — defensas anti book-stale (auditoría rentabilidad 2026-07-07): el cruce
# binario debe persistir N ticks para ejecutarse; cooldown por ticker tras fallo.
MOTOR_1_CONFIRM_TICKS=2
MOTOR_1_TICKER_COOLDOWN_SEC=60

# Salidas (M3 + exit de M2): bid mínimo para vender; debajo, la posición va a settle
# (el settle no paga fee — vender polvo dona fee+spread). 0 = sin piso.
MOTOR_3_MIN_SELL_BID_CENTS=5

# Motor 2 — entrada: mutua exclusión por EVENTO. true (default) = una sola apuesta direccional
# (mayor edge) por partido, aunque el edge aparezca en varios markets del mismo evento (previene
# la doble exposición correlacionada: yes en un equipo + no en el otro). false = previo.
MOTOR_2_ONE_BET_PER_EVENT=true

# Motor 2 — sizing FLAT por trade (% del capital), desacoplado de Kelly. >0 = fracción fija
# (Kelly sobre-apuesta donde el edge está sobreestimado → −19% ROI; flat dio +22.9% en la sim).
# 0 = ¼ Kelly previo. Default 1.0% conservador. El RiskManager re-capea aguas abajo.
MOTOR_2_MAX_STAKE_PCT=1.0
# Fee del edge medida al count REAL del stake flat (la fee ceil por orden repartida) en vez
# de count=1, que la sobreestima hasta +0.78pp en asks bajos. Shadow-first: prender y
# comparar el best_net_edge_pp del funnel antes/después ANTES de tocar MIN_EDGE.
MOTOR_2_FEE_AT_STAKE_COUNT=false
# Burst pre-kickoff: con partidos por arrancar en <45min el poller acelera (los edges
# reales son transitorios cerca del kickoff; a 300s se ven de casualidad). 0 = off.
# Recomendado con API de tarifa plana: 60.
MOTOR_2_BURST_INTERVAL_SEC=0.0
MOTOR_2_BURST_WINDOW_MIN=45.0

# Motor 6 (line-move follower) — F1 SHADOW: detecta saltos del fair entre ciclos que Kalshi
# aún no digirió. Solo observa (no existe executor); loguea [MOTOR 6 SHADOW] + EdgeWindow
# kind=linemove. Validar frecuencia/ROI simulado ANTES de siquiera diseñar F2.
MOTOR_6_LINEMOVE_ENABLED=false
MOTOR_6_MOVE_MIN_PP=3.0
MOTOR_6_EDGE_MIN_PP=2.0
MOTOR_6_MAX_EDGE_PP=10.0

# Motor 8 (OFI) — F1 SHADOW auto-validante: detecta desequilibrios anómalos del flujo de
# órdenes y mide el move REAL a T+30/T+60 (EdgeWindow kind=ofi). No asume dirección; F2
# decide contrarian vs momentum vs archivar con esos datos. Requiere el manager V2 activo.
MOTOR_8_OFI_ENABLED=false
MOTOR_8_OFI_WINDOW_SEC=60.0
MOTOR_8_OFI_Z_MIN=3.0
MOTOR_8_OFI_MIN_BASELINE=200
MOTOR_8_OFI_COOLDOWN_SEC=120.0

# Motor 9 (Derrame) — F1 SHADOW auto-validante: un salto ≥N¢ en un market debe ajustar a sus
# HERMANOS del mismo evento (prob conservada). El shadow captura el mid del hermano AL salto
# y mide qué se movió DESPUÉS (T+60/T+120, EdgeWindow kind=spillover, firmado desde la
# dirección esperada). Follow>0 = derrame rezagado capturable; ~0 = ajuste instantáneo →
# archivar. Pasajero del feed de deltas (cero API extra). Requiere el manager V2 activo.
MOTOR_9_SPILLOVER_ENABLED=false
MOTOR_9_TRIGGER_MOVE_CENTS=5.0
MOTOR_9_WINDOW_SEC=60.0
MOTOR_9_COOLDOWN_SEC=300.0

# Motor 5 — edge-skew (asymmetric quoting, F2): inclina las quotes hacia el lado donde el
# book está desplazado del fair (más flujo capturado del lado con edge). 0 = off (F1 puro).
MOTOR_MM_EDGE_SKEW_CENTS=0

# OrderbookManagerV2 — recovery (tunables en vivo; defaults sanos). El chunking parte el
# get_snapshot masivo (un sid de 223 tickers nunca volvía → timeout_x5, 2026-07-17); el
# bootstrap cap es el tope anti-OOM (2026-07-18). El BACKOFF (2026-07-21) reintenta un sid
# con circuit breaker tras un cooldown exponencial (30s→2min→8min→30min) en vez de dejarlo
# ciego hasta el redeploy — sid=1 (189 futuros sin book) disparaba el breaker en cada boot.
ORDERBOOK_V2_RECOVERY_TIMEOUT_SEC=30.0
ORDERBOOK_V2_MAX_RECOVERY_BUFFER=25000
ORDERBOOK_V2_RECOVERY_CHUNK_SIZE=50
ORDERBOOK_V2_BOOTSTRAP_BUFFER_CAP=1000
ORDERBOOK_V2_RECOVERY_BACKOFF_BASE_SEC=30.0
ORDERBOOK_V2_RECOVERY_BACKOFF_FACTOR=4.0
ORDERBOOK_V2_RECOVERY_BACKOFF_CAP_SEC=1800.0
# Anti-espiral (incidente 2026-07-31): gap dentro del intervalo NO re-bootstrapea (books
# stale y espera) — la recovery a 5/seg era la carga que generaba los gaps siguientes.
ORDERBOOK_V2_RECOVERY_MIN_INTERVAL_SEC=5.0
# Siembra explícita de books (P0 2026-08-02): sin esto los books solo nacían si un gap
# disparaba una recovery — 61h con initialized=0 tras matar los gaps falsos (#205).
ORDERBOOK_V2_SEED_WATCHDOG_INTERVAL_SEC=30.0

# Motor 1 — cap de exposición DIRECCIONAL acumulada por EVENTO (Bug 2, incidente 2026-07-07):
# los tickers hermanos de un partido son el MISMO evento; los residuales de netting/huérfanas
# se sumaban en la misma dirección ($135) sin control. Sobre el cap → no más arbs del evento.
MAX_EVENT_DIRECTIONAL_EXPOSURE_USD=25.0

# Motor 3 — gestionar HUÉRFANAS de Motor 1 (Bug 4): BUYs cuyo arb quedó sin la pata hermana
# (rollback abortado). SOLO huérfanas verdaderas — un hedge completo jamás se vende. Default off.
MOTOR_3_MANAGES_ORPHANS=false

# Motor REST — universo del path multi-outcome (auditoría 2026-07-12: estaba hardcodeado a
# 4 series del Mundial → fuera de las ventanas de partido, 0 evaluaciones). ⚠️ SOLO series
# winner-take-all (excluyentes y exhaustivas); NUNCA props/totals (no son excluyentes →
# "arb" falso que ejecuta plata real). Match por serie EXACTA.
MOTOR_REST_MULTI_SERIES=KXWCGAME,KXWCGROUPWIN,KXMENWORLDCUP,KXMWORLDCUP
MOTOR_REST_MULTI_MAX_QUOTE_AGE_SEC=30.0
MOTOR_REST_MULTI_MIN_LEGS=3

# Sentry / error tracking (opcional)
SENTRY_DSN=
