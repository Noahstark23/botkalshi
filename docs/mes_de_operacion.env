# =====================================================
# MES DE OPERACIÓN — bloque para pegar en Coolify
# =====================================================
# Environment Variables → recurso botkalshi → bloque de PRODUCCIÓN (¡no Preview!:
# ahí KALSHI_ENV=demo y el bankroll es otro). Pegar, Save, Redeploy.
#
# Verificación en un comando (read-only, no muta nada):
#   docker exec kalshi-bot python -m scripts.arranque_mes
# Gatillo final (lo tipea una PERSONA):
#   docker exec -it kalshi-bot python -m scripts.arranque_mes --arrancar
#
# CRITERIOS PRE-REGISTRADOS (para que el día 30 haya respuesta, no debate):
#   éxito   = PnL neto > 0, o Motor 1 (test PRIMARIO declarado) con t >= 2 positivo
#   archivo = PnL neto <= -$80, o t < 2 en todos
#   aborto  = -$100 (37% del capital efectivo) o 3 kill-switches en una semana
#
# RIESGOS CONOCIDOS, repetidos como manda el protocolo de activación:
#   M1 mide t=+0.69 sobre n=519 (ruido) y es el que produce las huérfanas.
#   M2 perdió -$433 y su edge medido techa en 0.15-0.31pp contra este umbral de 1.0pp;
#      con stake de ~$2.70 la pérdida peor-caso del mes queda en ~-$57 (acotada, dentro
#      del criterio de archivo) y a cambio se ejercita por primera vez el brazo de salidas.
#   REST tiene 73% de rollback (t=-4.73): su umbral NO se baja, bajarlo multiplica fallos.
#   M5 F3 queda AFUERA: quotes RESTING sin gestión si el proceso muere + 3 P1 abiertos.
#      Para incluirlo: correr scripts/motor5_smoke_test.py y después setear a mano
#      MOTOR_MM_EXECUTION_ENABLED=true junto con MOTOR_MM_F3_ACK=NOEL-OK-F3
#      (sin la llave el BOOT FALLA a propósito: van las dos o ninguna).
# =====================================================

# --- Maestro + Motor 1 (test PRIMARIO del mes) ---
TRADING_ENABLED=true
MOTOR_1_ARBITRAGE_ENABLED=true
MOTOR_1_EXECUTION_ENABLED=true
# Detección de la banda fina 1.0-1.5pp SIN bajar el piso de ejecución (que sigue en 1.5
# vía MOTOR_1_EXECUTION_EDGE_PCT): al día 15 se decide con settlements reales si conviene
# ejecutarla, sin haber pagado por averiguarlo. Shadow-first adentro del propio motor.
MIN_EDGE_PCT=1.0

# --- Motor 2 (fair + entradas chicas + salidas, por fin ejercitadas) ---
MOTOR_2_SPORTSBOOK_ENABLED=true
MOTOR_2_ENTRY_EXECUTION_ENABLED=true
MOTOR_2_EXECUTION_ENABLED=true
MOTOR_2_MIN_EDGE_PCT=1.0
MOTOR_2_MAX_STAKE_PCT=1.0
MOTOR_2_TAKE_PROFIT_ENABLED=true

# --- Motor 3 (salidas; gestiona las huérfanas para que no quede plata parada) ---
MOTOR_3_CLV_ENABLED=true
MOTOR_3_EXECUTION_ENABLED=true
MOTOR_3_MANAGES_ORPHANS=true

# --- Motor REST (umbral SIN cambios: su problema es ejecución, no umbral) ---
MOTOR_REST_ENABLED=true
MOTOR_REST_EXECUTION_ENABLED=true

# --- Shadows que siguen midiendo gratis ---
MOTOR_8_OFI_ENABLED=true
MOTOR_9_SPILLOVER_ENABLED=true

# --- Colchón (NO opcional: es lo único que acota el daño) ---
MAX_TRADE_SIZE_PCT=3.0
MAX_EVENT_DIRECTIONAL_EXPOSURE_USD=15.0
# Piso diario a $25: con sigma diaria de M1 ~$10, el stop de $20 se disparaba por varianza
# normal y pausaba entradas cada dos días. Semanal/mensual/kill-switch quedan intactos.
MAX_DAILY_LOSS_FLOOR_USD=25.0

# =====================================================
# OPCIONAL — respuesta proporcional a la pata huérfana
# =====================================================
# Evidencia: 3 abortos de rollback en 21 días (25% de los 12 partial fills), TODOS de 1
# contrato (~$0.47), y cada uno paró el bot ENTERO 14+ horas con el kill-switch global.
# Con esto en true: huérfana < $5 pausa SOLO Motor 1 (runtime) y Motor 3 la gestiona;
# huérfana >= $5 dispara el kill-switch global como hoy; y 3 abortos en 24h escalan al
# global igual (repetido = mercado roto, no accidente).
# ⚠️ Es ABLANDAR una capa de seguridad nacida del incidente de ~$135 del 2026-07-07:
# decisión explícita del operador. Sin esta línea, el comportamiento es el histórico.
# MOTOR_1_PROPORTIONAL_ORPHAN_PAUSE=true
# MOTOR_1_ORPHAN_KILL_SWITCH_USD=5.0
# MOTOR_1_ORPHAN_ESCALATE_COUNT=3
