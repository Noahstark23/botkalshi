# ASTRA-DEPLOY-SUPERVISION-20260924 — read-only supervision of the production snapshot.
# Alerts go to a LOCAL outbox (no network, no credentials). Timer not enabled by default.
# No trading authority: never set_pause, /admin/*, clear_kill_switch or any executor.
[Unit]
Description=botkalshi read-only production supervision (no trading authority)

[Service]
Type=oneshot
User=botkalshi-supervisor
Group=botkalshi-supervisor
WorkingDirectory=/opt/botkalshi/infra/digitalocean-shadow
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=KALSHI_API_KEY_ID KALSHI_PRIVATE_KEY KALSHI_PRIVATE_KEY_PATH TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID ODDS_API_KEY OPENAI_API_KEY PYTHONPATH PYTHONHOME PYTHONINSPECT PYTHONOPTIMIZE
# Root pre-step copies the snapshot; if it fails the copies are removed and the reader
# still runs ("-" prefix) so the outage is REPORTED as MISSING/SERVICE_DOWN, not hidden.
ExecStartPre=-+/usr/bin/python3 -I /opt/botkalshi/infra/digitalocean-shadow/supervision_collect.py --env /etc/botkalshi-supervision.env --inbox /var/lib/botkalshi-supervision/inbox --owner botkalshi-supervisor
ExecStart=/usr/bin/python3 /opt/botkalshi/infra/digitalocean-shadow/supervision_reader.py --snapshot /var/lib/botkalshi-supervision/inbox/snapshot.json --audit /var/lib/botkalshi-supervision/audit/latest.json --state /var/lib/botkalshi-supervision/alerts/state.json --outbox /var/lib/botkalshi-supervision/alerts/outbox.jsonl --report /var/lib/botkalshi-supervision/reader/latest.json
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/botkalshi-supervision
InaccessiblePaths=-/etc/botkalshi-research.env -/etc/botkalshi-assistant -/etc/botkalshi-telegram
UMask=0077
LimitCORE=0
MemoryMax=128M
CPUQuota=15%
TasksMax=16
TimeoutStartSec=60
LogRateLimitIntervalSec=60
LogRateLimitBurst=50
