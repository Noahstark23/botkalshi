# Propuesta local para comprobar cobertura y límites. No inicia ni activa órdenes.
# Revisar junto al operador; no reemplazar runtime.env ni copiar credenciales aquí.
KALSHI_ENV=production
TRADING_ENABLED=false
MOTOR_1_EXECUTION_ENABLED=false
MOTOR_2_ENTRY_EXECUTION_ENABLED=false
MOTOR_2_EXECUTION_ENABLED=false
MOTOR_3_EXECUTION_ENABLED=false
MOTOR_REST_EXECUTION_ENABLED=false
MOTOR_MM_EXECUTION_ENABLED=false
MOTOR_1_ARBITRAGE_ENABLED=false
MOTOR_2_SPORTSBOOK_ENABLED=false
MOTOR_3_CLV_ENABLED=false
MOTOR_REST_ENABLED=false
MOTOR_MM_ENABLED=false
MOTOR_6_LINEMOVE_ENABLED=false
MOTOR_8_OFI_ENABLED=false
MOTOR_9_SPILLOVER_ENABLED=false
EXPERIMENT_BANK200_ENABLED=false
ANALYST_LOOP_ENABLED=false
DAILY_PNL_REPORT_ENABLED=false
TELEGRAM_DASHBOARD_ENABLED=false
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Partidos NFL además de MLB, ya incluido en la lista base.
DISCOVERY_EXTRA_SERIES=KXNFLGAME
MOTOR2_SERIES=KXMLBGAME,KXNFLGAME
ODDS_API_SPORT_KEYS=baseball_mlb,americanfootball_nfl

# Techo fijo para la prueba: nuevos depósitos no amplían la asignación.
ACTIVE_CAPITAL_USD=200
CAPITAL_CAP_USD=200
DYNAMIC_CAPITAL_ENABLED=true
CAPITAL_SMOOTHING_PCT=0
BALANCE_REFRESH_SECONDS=300
BALANCE_MAX_AGE_SECONDS=600
# Conservar las protecciones existentes; no elevar stops al máximo tolerado.
CAPITAL_FLOOR_USD=100
CAPITAL_SAFETY_FACTOR_PCT=90
HEALTH_HOST=127.0.0.1
HEALTH_PORT=18080
