[Unit]
Description=BotKalshi sanitized read-only status exporter (no Telegram credential)
After=network.target

[Service]
Type=simple
User=botkalshi-status
Group=botkalshi-status
WorkingDirectory=/opt/botkalshi-panel/current
ExecStart=/usr/bin/python3 -B /opt/botkalshi-panel/current/runtime_status_cache.py
StateDirectory=botkalshi-status
StateDirectoryMode=0755
Restart=on-failure
RestartSec=30
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectHostname=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
MemoryDenyWriteExecute=true
RemoveIPC=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
CapabilityBoundingSet=
AmbientCapabilities=
InaccessiblePaths=-/etc/botkalshi-panel -/var/lib/botkalshi-panel -/etc/botkalshi-runtime -/etc/botkalshi-research.env -/opt/botkalshi-runtime -/opt/botkalshi-live -/opt/botkalshi-research -/var/lib/botkalshi-runtime -/var/lib/botkalshi-research -/var/run/docker.sock -/var/lib/botkalshi-us500-data -/data/coolify -/var/lib/docker
MemoryMax=48M
MemorySwapMax=0
CPUQuota=5%
TasksMax=8
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
